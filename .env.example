# Convex — run `bunx convex dev` and paste deployment URL
NEXT_PUBLIC_CONVEX_URL=

# Clerk — from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional. Paths to hosted auth pages (same on every subdomain).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# In Clerk Dashboard → Paths / Redirect URLs, allow every host you serve
# (apex + subdomains), e.g. https://example.com/* and https://*.example.com/*

# Convex auth config — Clerk JWT template "convex" issuer (Frontend API URL host)
# Example: https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

